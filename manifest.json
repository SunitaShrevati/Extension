{
  "manifest_version": 3,
  "name": "Page Color & Font Picker",
  "description": "Collects colors and fonts used on the current page and lets you pick/copy them.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pick colors & fonts"
  },
  "icons": {},
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
